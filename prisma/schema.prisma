datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl"]
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("admin")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]
  pages     Page[]
  shares    Share[]
  auditLogs AuditLog[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Page {
  id           String   @id @default(cuid())
  userId       String
  title        String
  icon         String   @default("layout")
  order        Int      @default(0)
  layoutConfig String   @default("{}")
  theme        String   @default("dark")
  background   String   @default("default")
  customCss    String?
  isPublic     Boolean  @default(false)
  slug         String?  @unique
  passwordHash String?
  isArchived   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  columns Column[]
  shares  Share[]
}

model Column {
  id        String   @id @default(cuid())
  pageId    String
  order     Int      @default(0)
  width     Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  page    Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  widgets Widget[]
}

model Widget {
  id        String   @id @default(cuid())
  columnId  String
  type      String
  order     Int      @default(0)
  title     String
  config    String   @default("{}")
  collapsed Boolean  @default(false)
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  column    Column     @relation(fields: [columnId], references: [id], onDelete: Cascade)
  bookmarks Bookmark[]
}

model Bookmark {
  id          String   @id @default(cuid())
  widgetId    String
  parentId    String?
  url         String
  title       String
  description String?
  favicon     String?
  tags        String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  widget Widget @relation(fields: [widgetId], references: [id], onDelete: Cascade)
}

model Share {
  id        String   @id @default(cuid())
  pageId    String
  userId    String
  role      String   @default("viewer")
  createdAt DateTime @default(now())

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pageId, userId])
}

model FeedCache {
  id        String   @id @default(cuid())
  url       String   @unique
  content   String
  fetchedAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  details   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
