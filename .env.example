# OmniDash - .env.example

# 1. Datenbank-Pfad für SQLite
DATABASE_URL="file:./dev.db"

# 2. Secret für verschlüsselte Auth-Sessions
NEXTAUTH_SECRET="omnidash-super-secret-key-change-in-production"

# 3. Öffentliche App URL
NEXTAUTH_URL="http://localhost:3000"

# 4. Optional: Fester 10-stelliger Admin Token (z.B. "a1b2c3d4e5")
ADMIN_TOKEN="a1b2c3d4e5"
