# OmniDash - .env.example

# 1. Datenbank-Pfad für Prisma SQLite (oder Postgres Connection String)
DATABASE_URL="file:./dev.db"

# 2. NextAuth Secret (Generieren mit `openssl rand -base64 32` oder einem beliebigen sicheren String)
NEXTAUTH_SECRET="omnidash-super-secret-key-change-in-production"

# 3. Öffentliche URL der Anwendung
NEXTAUTH_URL="http://localhost:3000"
